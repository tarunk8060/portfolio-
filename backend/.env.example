# ==============================================================================
# Tarun.K Portfolio CMS - Environment Configuration Example
# Copy this file to .env and configure with your actual credentials.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True

# Database Configuration
# Option A: Supabase PostgreSQL (Recommended for production)
# Format: postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-supabase-id.supabase.co:5432/postgres

# Option B: Local SQLite fallback (Preconfigured for zero-setup local dev/testing)
DATABASE_URL=sqlite+aiosqlite:///./portfolio.db

# Admin Authentication & JWT Security
# Generate a secure 64-character secret with: openssl rand -hex 32
JWT_SECRET=super-secret-production-key-change-in-env-tarunk-2026-portfolio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials (seeded on first run)
ADMIN_EMAIL=admin@tarunk.dev
ADMIN_PASSWORD=Admin@TarunK2026!
ADMIN_NAME=Tarun K

# Supabase Object Storage (Optional for cloud media persistence)
# If left blank, uploads are automatically stored in the persistent local backend/uploads directory
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=portfolio-media

# CORS Allowed Origins (Comma-separated in production)
# Local portfolio & admin origins are allowed by default
